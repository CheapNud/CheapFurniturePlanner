<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <UserSecretsId>cheap-furniture-planner-desktop</UserSecretsId>

    <!-- Package Information -->
    <AssemblyTitle>Cheap Furniture Planner</AssemblyTitle>
    <Product>Cheap Furniture Planner</Product>
    <Description>A generic furniture planning application for room layouts</Description>
    <Company>Cheap Software Solutions</Company>
    <Copyright>Copyright © Cheap Software Solutions</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CheapAvaloniaBlazor" Version="3.4.1" />
    <!-- Direct reference (also transitive via CheapAvaloniaBlazor): the Velopack startup
         hook must be called from THIS assembly's Main - vpk pack verifies the entry
         assembly and fails the release build otherwise. Keep the version in lock-step
         with the framework's Velopack and the vpk tool pin in deploy/release.ps1. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="CheapHelpers" Version="3.8.0" />
    <PackageReference Include="CheapHelpers.Blazor" Version="3.8.0" />
    <PackageReference Include="CheapHelpers.EF" Version="3.8.0" />
    <PackageReference Include="CheapHelpers.Models" Version="3.8.0" />
    <PackageReference Include="CheapHelpers.Services" Version="3.8.0" />


    <!-- Entity Framework for SQLite (default provider) and PostgreSQL (MB-1 hosted-mode opt-in) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Config providers for Database:Provider selection - the base Configuration package is
         already pulled in transitively, but no concrete source (JSON file, env vars) was wired
         up before this. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />

    <!-- MudBlazor for UI components -->
    <PackageReference Include="MudBlazor" Version="9.8.0" />

    <!-- Mapster for object mapping -->
    <PackageReference Include="Mapster" Version="10.0.12" />
    <PackageReference Include="Mapster.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded resources -->
    <EmbeddedResource Include="Resources\**\*" />
    <EmbeddedResource Include="Seed\demo-catalogue.json" />

    <!-- Static web assets -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not auto-copied to the output directory like on the Web SDK - this project uses
         Microsoft.NET.Sdk.Razor, which already picks the file up as a default Content item, it
         just needs CopyToOutputDirectory added. -->
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
    <Folder Include="Assets\Images\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="CheapFurniturePlanner.Domain\CheapFurniturePlanner.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CheapFurniturePlanner.Domain\**;CheapFurniturePlanner.Domain.Tests\**;CheapFurniturePlanner.Tests\**;CheapFurniturePlanner.Migrations.Postgres\**" />
    <Content Remove="CheapFurniturePlanner.Domain\**;CheapFurniturePlanner.Domain.Tests\**;CheapFurniturePlanner.Tests\**;CheapFurniturePlanner.Migrations.Postgres\**" />
    <None Remove="CheapFurniturePlanner.Domain\**;CheapFurniturePlanner.Domain.Tests\**;CheapFurniturePlanner.Tests\**;CheapFurniturePlanner.Migrations.Postgres\**" />
    <EmbeddedResource Remove="CheapFurniturePlanner.Domain\**;CheapFurniturePlanner.Domain.Tests\**;CheapFurniturePlanner.Tests\**;CheapFurniturePlanner.Migrations.Postgres\**" />
  </ItemGroup>

</Project>