<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField T="string" Label="Code" @bind-Value="_code" Required="true" />
            <MudTextField T="string" Label="Name" @bind-Value="_name" Required="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@SubmitLabel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Region? Region { get; set; }

    [Parameter]
    public string SubmitLabel { get; set; } = "Save";

    private string _code = string.Empty;
    private string _name = string.Empty;

    protected override void OnInitialized()
    {
        if (Region is not null)
        {
            _code = Region.Code;
            _name = Region.Name;
        }
    }

    private void Submit() => MudDialog.Close(DialogResult.Ok(new Region { Code = _code.Trim(), Name = _name.Trim() }));
}
