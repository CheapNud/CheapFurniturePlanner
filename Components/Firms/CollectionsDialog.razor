<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (_collections.Count == 0)
            {
                <MudText Typo="Typo.body2">No collections attached to this firm yet.</MudText>
            }
            else
            {
                <MudTable Items="_collections" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Code</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh />
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Code">@context.Code</MudTd>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd>
                            <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Title="Rename collection"
                                               OnClick="@(() => RenameAsync(context))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Title="Remove collection"
                                               OnClick="@(() => RemoveAsync(context))" />
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudTextField T="string" Label="Code" @bind-Value="_newCode" Immediate="true" />
                <MudTextField T="string" Label="Name" @bind-Value="_newName" Immediate="true" />
                <ProgressButton Disabled="@(string.IsNullOrWhiteSpace(_newCode) || string.IsNullOrWhiteSpace(_newName))"
                           OnClick="AddAsync">Add</ProgressButton>
            </MudStack>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Firm Firm { get; set; } = default!;

    [Inject]
    private FirmService Firms { get; set; } = default!;

    [Inject]
    private IDialogService DialogService { get; set; } = default!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    private List<Collection> _collections = [];
    private string _newCode = string.Empty;
    private string _newName = string.Empty;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync() =>
        _collections = (await Firms.AllCollectionsAsync()).Where(c => c.FirmId == Firm.Id).ToList();

    private async Task AddAsync()
    {
        try
        {
            await Firms.AddCollectionAsync(Firm.Id, _newCode, _newName);
            _newCode = string.Empty;
            _newName = string.Empty;
        }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
        await ReloadAsync();
    }

    private async Task RenameAsync(Collection registryRow)
    {
        // Simple inline rename: reuse the add fields is confusing - prompt via a message box is
        // not possible for text input, so swap the row name with the Name field value if filled.
        // Keep it minimal: rename uses the Name input when non-blank, else no-op with a hint.
        if (string.IsNullOrWhiteSpace(_newName))
        {
            Snackbar.Add("Type the new name in the Name field, then click rename.", Severity.Info);
            return;
        }
        try { await Firms.RenameCollectionAsync(registryRow.Id, _newName); _newName = string.Empty; }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
        await ReloadAsync();
    }

    private async Task RemoveAsync(Collection registryRow)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Remove collection",
            $"Remove collection '{registryRow.Code}'? Models with this code will fall back to the default firm.",
            yesText: "Remove", cancelText: "Cancel");
        if (confirmed != true) { return; }
        try { await Firms.DeleteCollectionAsync(registryRow.Id); }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
        await ReloadAsync();
    }
}
