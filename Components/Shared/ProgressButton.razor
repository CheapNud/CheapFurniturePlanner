<MudButton Variant="Variant" Color="Color" Size="Size" FullWidth="FullWidth" Class="@Class" Disabled="@(Disabled || _running)" Title="@Title" OnClick="HandleClickAsync">
    @if (_running)
    {
        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
    }
    else if (StartIcon is not null)
    {
        <MudIcon Icon="@StartIcon" Class="mr-2" Size="Size.Small" />
    }
    @ChildContent
</MudButton>

@code {
    // EVERY awaited button action converts to this - self-disables while OnClick's task is in
    // flight (StartIcon swaps for a spinner), a field guards against a second click landing
    // mid-flight, and the running flag always resets in finally, exception or not.
    //
    // OnClick is EventCallback, not a plain Func<Task>: a plain delegate carries no "receiver",
    // so completing it would only ever trigger a re-render of THIS component, never of the page
    // that owns the handler and mutated its own fields inside it (Blazor's automatic
    // render-after-event only fires on an EventCallback's captured receiver). Razor's compiler
    // captures that receiver automatically for "OnClick=SomeMethod" call sites, exactly like
    // MudButton's own OnClick - callers don't have to do anything differently.
    [Parameter, EditorRequired] public EventCallback OnClick { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Filled;
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public string? StartIcon { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _running;

    private async Task HandleClickAsync()
    {
        if (_running)
        {
            return;
        }

        _running = true;
        try
        {
            await OnClick.InvokeAsync();
        }
        finally
        {
            _running = false;
        }
    }
}
