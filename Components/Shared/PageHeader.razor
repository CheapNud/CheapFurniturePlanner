<div class="d-flex flex-wrap align-center justify-space-between gap-4 mb-6">
    <div>
        @if (Kicker is not null)
        {
            <MudText Typo="Typo.overline" Class="mud-text-secondary">@Kicker</MudText>
        }
        <MudText Typo="Typo.h4">@Title</MudText>
        @if (Subtitle is not null)
        {
            <MudText Typo="Typo.body2">@Subtitle</MudText>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="d-flex align-center gap-2">
            @Actions
        </div>
    }
</div>

@code {
    // The kicker names the SECTION (module: STUDIO / PARTIES / ORDERS / ...), the title the
    // ACTION on that section - so it stays optional (not every consumer wants a module label).
    [Parameter] public string? Kicker { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
