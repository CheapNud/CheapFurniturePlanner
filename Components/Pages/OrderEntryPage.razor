@page "/orders/{OrderId:int}"
@attribute [Authorize(Roles = Roles.AdminOrOffice)]
@using CheapFurniturePlanner.Components.Orders
@using CheapFurniturePlanner.Domain.Catalog
@using CheapFurniturePlanner.Domain.Serialization
@using CheapFurniturePlanner.Ui
@inject OrderEntryService OrderEntryService
@inject PartyService Parties
@inject FirmService Firms
@inject ProductionUnitService Units
@inject InvoicingService Invoicing
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Order</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
@if (_order is null)
{
    <MudAlert Severity="Severity.Error">Order not found.</MudAlert>
}
else
{
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Title="Back to orders" OnClick="@(() => Navigation.NavigateTo("/orders"))" Class="mb-2" />
    <PageHeader Kicker="ORDERS" Title="@_order.OrderNumber">
        <Actions>
            <StatusChip Color="@StatusColors.For(_order.State)" Value="@_order.State.ToString()" />
            @if (_phase is ProductionPhase orderPhase)
            {
                <StatusChip Color="@StatusColors.For(orderPhase)" Value="@orderPhase.ToString()" />
            }
            @if (_order.State == OrderState.Draft)
            {
                <ProgressButton OnClick="PlaceAsync">Place order</ProgressButton>
                <ProgressButton Variant="Variant.Text" Color="Color.Error" OnClick="CancelAsync">Cancel order</ProgressButton>
            }
            @if (_order.State == OrderState.Placed && _invoice is null)
            {
                <ProgressButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ReceiptLong" OnClick="CreateInvoiceAsync">Create invoice</ProgressButton>
            }
            else if (_invoice is not null)
            {
                <MudLink Href="@($"/invoices/{_invoice.Id}")">@_invoice.InvoiceNumber</MudLink>
            }
        </Actions>
    </PageHeader>

    <MudPaper Class="pa-6 mb-6" Elevation="0">
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2">Seller: @_order.Seller?.Name — Consumer: @_order.Consumer?.Name — Market: @_order.MarketCode</MudText>
            <MudSelect T="int?" Label="Delivery address" Value="@SelectedDeliveryAddressBookEntryId" ValueChanged="SetDeliveryAddressAsync"
                       Disabled="@(_order.State != OrderState.Draft)" Clearable="true">
                @foreach (var entry in _deliveryAddresses)
                {
                    <MudSelectItem T="int?" Value="@((int?)entry.Id)">@($"{entry.Label} — {entry.Address!.ToOneLine()}")</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="int?" Label="Firm" Value="@_order.FirmId" ValueChanged="SetFirmAsync"
                       Disabled="@(_order.State != OrderState.Draft)" Clearable="true">
                @foreach (var firmChoice in _firmChoices)
                {
                    <MudSelectItem T="int?" Value="@((int?)firmChoice.Id)">@firmChoice.Name</MudSelectItem>
                }
            </MudSelect>
            @* Unlike its Draft-only neighbors above, this stays enabled once Placed too: the office
               promises/reschedules a delivery date while production is running, not just up front.
               Only Cancelled disables it - see OrderEntryService.SetPromisedDeliveryDateAsync. *@
            <MudDatePicker Label="Promised delivery" Date="@_order.PromisedDeliveryDate" DateChanged="SetPromisedDeliveryDateAsync"
                           Disabled="@(_order.State == OrderState.Cancelled)" Clearable="true" />
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@(_order.PinnedCatalogueVersion ?? "not pinned yet")</MudChip>
                <MudText Typo="Typo.subtitle1">Total: @OrderEntryService.OrderTotal(_order).ToString("C2")</MudText>
                @if (_order.State == OrderState.Draft)
                {
                    <MudNumericField T="decimal" Label="Order discount %" Min="0" Max="100"
                                      Value="@_order.OrderDiscountPercent"
                                      ValueChanged="@((decimal pct) => SetOrderDiscountAsync(pct))" />
                }
                else
                {
                    <MudText Typo="Typo.body2">Order discount: @_order.OrderDiscountPercent.ToString("0.##")%</MudText>
                }
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (_order.State == OrderState.Draft)
    {
        <MudTabs @ref="_tabs" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Class="mb-6">
            <MudTabPanel Text="Element">
                <ElementEntryTab @ref="_elementTab" Order="_order" OnChanged="ReloadAsync" />
            </MudTabPanel>
            <MudTabPanel Text="Article">
                <ArticleEntryTab Order="_order" OnChanged="ReloadAsync" OnConfigureArticle="OnConfigureArticle" />
            </MudTabPanel>
        </MudTabs>
    }

    <MudPaper Class="pa-6" Elevation="0">
        <MudTable Items="@_order.Lines" Hover="true" Dense="true" T="OrderLine" Loading="@_loading">
            <HeaderContent>
                <MudTh>Code</MudTh>
                <MudTh>Kind</MudTh>
                <MudTh>Quantity</MudTh>
                <MudTh>Unit price</MudTh>
                <MudTh>Discount</MudTh>
                <MudTh>Line total</MudTh>
                <MudTh>Supplier ref</MudTh>
                <MudTh>Production</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Code">
                    @if (context.Kind == OrderLineKind.ConfiguredElement && context.AssignedCode is null)
                    {
                        <MudTooltip Text="unnamed variant">
                            <MudText>@(context.VariantCode ?? "")</MudText>
                        </MudTooltip>
                    }
                    else
                    {
                        @(context.AssignedCode ?? context.VariantCode ?? "")
                    }
                </MudTd>
                <MudTd DataLabel="Kind">@(context.Kind == OrderLineKind.StandaloneArticle ? "Standalone" : "Configured")</MudTd>
                <MudTd DataLabel="Quantity">
                    @if (_order.State == OrderState.Draft)
                    {
                        <MudNumericField T="int" Value="@context.Quantity" Min="1" ValueChanged="@(qty => UpdateQuantityAsync(context, qty))" />
                    }
                    else
                    {
                        @context.Quantity
                    }
                </MudTd>
                <MudTd DataLabel="Unit price">@context.UnitPrice.ToString("C2")</MudTd>
                <MudTd DataLabel="Discount">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        @if (_order.State == OrderState.Draft)
                        {
                            <MudNumericField T="decimal" Min="0" Max="100"
                                              Value="@context.DiscountPercent"
                                              ValueChanged="@((decimal pct) => SetLineDiscountAsync(context, pct))" />
                        }
                        else
                        {
                            <MudText>@context.DiscountPercent.ToString("0.##")%</MudText>
                        }
                        @if (context.DiscountSource is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.DiscountSource</MudChip>
                        }
                        else if (context.DiscountIsManual)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">manual</MudChip>
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Line total">@context.LineTotal.ToString("C2")</MudTd>
                <MudTd DataLabel="Supplier ref">@(context.Supplier is null ? "" : $"{context.Supplier.Code} - {context.Supplier.Name}")</MudTd>
                <MudTd DataLabel="Production">
                    @if (_order.State == OrderState.Draft && context.Kind == OrderLineKind.StandaloneArticle && context.SupplierId is not null)
                    {
                        <MudSwitch T="bool" Value="@context.DeliverToWarehouse" Color="Color.Primary" Label="Via warehouse"
                                   ValueChanged="@((bool viaWarehouse) => SetDeliverToWarehouseAsync(context.Id, viaWarehouse))" />
                    }
                    else if (_order.State == OrderState.Placed)
                    {
                        @foreach (var unit in _units.Where(u => u.OrderLineId == context.Id))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@StatusColors.For(unit.State)">@unit.SequenceNumber: @StatusText.Humanize(unit.State.ToString())</MudChip>
                        }
                    }
                </MudTd>
                <MudTd DataLabel="Actions">
                    @if (_order.State == OrderState.Draft)
                    {
                        <MudStack Row="true" Spacing="1">
                            <ProgressButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RemoveLineAsync(context))">Remove</ProgressButton>
                            @if (context.Kind == OrderLineKind.ConfiguredElement)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => CopyToConfigurator(context))">Copy to configurator</MudButton>
                            }
                        </MudStack>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Text="No lines yet - add one below" />
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}
</MudContainer>

@code {
    [Parameter]
    public int OrderId { get; set; }

    private Order? _order;
    private ProductionPhase? _phase;
    private List<ProductionUnit> _units = [];
    private Invoice? _invoice;
    private List<ConsumerDeliveryAddress> _deliveryAddresses = [];
    private List<Firm> _firmChoices = [];
    private MudTabs? _tabs;
    private ElementEntryTab? _elementTab;
    private bool _loading;

    // The book entry whose Address matches the order's current DeliveryAddressId - the select
    // shows the label/entry, not the raw Address row.
    private int? SelectedDeliveryAddressBookEntryId =>
        _deliveryAddresses.FirstOrDefault(d => d.AddressId == _order!.DeliveryAddressId)?.Id;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Loading failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _order = await OrderEntryService.GetOrderAsync(OrderId);
            _phase = await Units.PhaseForOrderAsync(OrderId);
            _units = await Units.UnitsForOrderAsync(OrderId);
            _invoice = await Invoicing.InvoiceForOrderAsync(OrderId);
            _deliveryAddresses = _order is null ? [] : await Parties.DeliveryAddressesAsync(_order.ConsumerId);
            _firmChoices = await Firms.FirmsAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SetFirmAsync(int? firmId)
    {
        try
        {
            await OrderEntryService.SetFirmAsync(OrderId, firmId);
        }
        catch (Exception ex) when (ex is InvalidOperationException or OrderPlacedException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task SetDeliveryAddressAsync(int? bookEntryId)
    {
        try
        {
            await OrderEntryService.SetDeliveryAddressAsync(OrderId, bookEntryId);
        }
        catch (Exception ex) when (ex is InvalidOperationException or OrderPlacedException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task SetPromisedDeliveryDateAsync(DateTime? promisedDate)
    {
        try
        {
            await OrderEntryService.SetPromisedDeliveryDateAsync(OrderId, promisedDate);
        }
        catch (InvalidOperationException failure)
        {
            Snackbar.Add(failure.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task CreateInvoiceAsync()
    {
        try
        {
            var invoice = await Invoicing.CreateInvoiceAsync(OrderId);
            Navigation.NavigateTo($"/invoices/{invoice.Id}");
        }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }

    private async Task PlaceAsync()
    {
        try
        {
            await OrderEntryService.PlaceAsync(OrderId);
        }
        catch (Exception ex) when (ex is InvalidOperationException or OrderPlacedException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task CancelAsync()
    {
        try
        {
            await OrderEntryService.CancelAsync(OrderId);
        }
        catch (Exception ex) when (ex is InvalidOperationException or OrderPlacedException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task UpdateQuantityAsync(OrderLine line, int quantity)
    {
        try
        {
            await OrderEntryService.UpdateQuantityAsync(OrderId, line.Id, quantity);
        }
        catch (Exception ex) when (ex is InvalidOperationException or OrderPlacedException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task SetLineDiscountAsync(OrderLine line, decimal percent)
    {
        try
        {
            await OrderEntryService.SetLineDiscountAsync(OrderId, line.Id, percent);
        }
        catch (Exception ex) when (ex is InvalidOperationException or OrderPlacedException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task SetOrderDiscountAsync(decimal percent)
    {
        try
        {
            await OrderEntryService.SetOrderDiscountAsync(OrderId, percent);
        }
        catch (Exception ex) when (ex is InvalidOperationException or OrderPlacedException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task SetDeliverToWarehouseAsync(int lineId, bool viaWarehouse)
    {
        try
        {
            await OrderEntryService.SetDeliverToWarehouseAsync(OrderId, lineId, viaWarehouse);
        }
        catch (Exception ex) when (ex is InvalidOperationException or OrderPlacedException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task RemoveLineAsync(OrderLine line)
    {
        try
        {
            await OrderEntryService.RemoveLineAsync(OrderId, line.Id);
        }
        catch (Exception ex) when (ex is InvalidOperationException or OrderPlacedException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    // SIMPLIFICATION (per Task 6 dispatch): rather than an in-place Reconfigure-on-Add flow, this
    // prefills the Element tab with the line's configuration so the user reviews/adjusts and Adds a
    // fresh line, then Removes the old one themselves. Avoids a stateful "editing line N" mode.
    private void CopyToConfigurator(OrderLine line)
    {
        if (line.ModelCode is null || line.ElementCode is null)
        {
            return;
        }
        var selections = CanonicalJson.Deserialize<Dictionary<string, string>>(line.SelectionsJson) ?? [];
        _elementTab?.Prefill(line.ModelCode, line.ElementCode, selections);
        if (_tabs is not null)
        {
            _tabs.ActivePanelIndex = 0;
        }
    }

    private void OnConfigureArticle(Article article)
    {
        if (article.ModelCode is null || article.ElementCode is null)
        {
            return;
        }
        _elementTab?.Prefill(article.ModelCode, article.ElementCode, article.Selections);
        if (_tabs is not null)
        {
            _tabs.ActivePanelIndex = 0;
        }
    }
}
