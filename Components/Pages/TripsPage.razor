@page "/trips"
@using CheapFurniturePlanner.Auth
@using CheapFurniturePlanner.Models
@using CheapFurniturePlanner.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = Roles.WarehouseStaff)]
@inject ProductionUnitService Units
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Trips</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <PageHeader Kicker="TRIPS" Title="Trips">
        <Actions>
            @if (_trips.Count > 0)
            {
                <ProgressButton OnClick="NewTripAsync" StartIcon="@Icons.Material.Filled.Add">New trip</ProgressButton>
            }
        </Actions>
    </PageHeader>

    <MudPaper Class="pa-6" Elevation="0">
        <MudTable T="Trip" Items="_trips" Hover="true" Dense="true" Loading="@_loading"
                  OnRowClick="@((TableRowClickEventArgs<Trip> args) => Navigation.NavigateTo($"/trips/{args.Item!.Id}"))">
            <HeaderContent>
                <MudTh>Trip</MudTh>
                <MudTh>Departure</MudTh>
                <MudTh>Truck</MudTh>
                <MudTh>Region</MudTh>
                <MudTh>State</MudTh>
                <MudTh>Units</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Trip">@context.TripCode</MudTd>
                <MudTd DataLabel="Departure">@(context.DepartureDate?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
                <MudTd DataLabel="Truck">@context.TruckName</MudTd>
                <MudTd DataLabel="Region">@context.Region?.Code</MudTd>
                <MudTd DataLabel="State"><StatusChip Color="@StatusColors.For(context.State)" Value="@context.State.ToString()" /></MudTd>
                <MudTd DataLabel="Units">@context.Units.Count</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Text="No trips planned" ActionText="New trip" OnAction="NewTripAsync" />
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<Trip> _trips = [];
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Loading failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _trips = await Units.ListTripsAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task NewTripAsync()
    {
        try
        {
            var trip = await Units.CreateTripAsync();
            Navigation.NavigateTo($"/trips/{trip.Id}");
        }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }
}
