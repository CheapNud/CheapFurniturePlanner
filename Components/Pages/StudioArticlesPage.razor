@page "/studio/articles"
@attribute [Authorize(Roles = Roles.AdminOrOffice)]
@using CheapFurniturePlanner.Catalogue
@using CheapFurniturePlanner.Components.Studio
@using CheapFurniturePlanner.Domain.Catalog
@using CheapFurniturePlanner.Services

@inject AuthoringCatalogueStore AuthoringCatalogueStore
@inject ArticleAuthoringService ArticleAuthoringService
@inject PartyService Parties
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Articles</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <PageHeader Kicker="STUDIO" Title="Articles" />

    <MudPaper Elevation="0" Class="pa-6 mb-6">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h6">Standalone articles</MudText>
            @if (_standalone.Count > 0)
            {
                <ProgressButton StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddAsync())">
                    Add article
                </ProgressButton>
            }
        </MudStack>
        <MudTable Items="@_standalone" Hover="true" Dense="true" Elevation="0" T="Article">
            <HeaderContent>
                <MudTh>Code</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Manual price</MudTh>
                <MudTh>Supplier</MudTh>
                <MudTh>State</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Code">@context.AssignedCode</MudTd>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Manual price">@context.ManualPrice</MudTd>
                <MudTd DataLabel="Supplier">
                    @context.SupplierRef
                    @if (UnknownSupplier(context))
                    {
                        <StatusChip Color="Color.Warning" Value="unknown supplier code" />
                    }
                </MudTd>
                <MudTd DataLabel="State">
                    <StatusChip Color="@StatusColors.For(context.State)" Value="@context.State.ToString()" />
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudStack Row="true" Spacing="1">
                        <ProgressButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => EditAsync(context))">Edit</ProgressButton>
                        <ProgressButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeleteAsync(context))">Delete</ProgressButton>
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Text="No standalone articles yet." ActionText="Add article" OnAction="@(() => AddAsync())" />
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>

    <MudPaper Elevation="0" Class="pa-6 mb-6">
        <MudText Typo="Typo.h6" Class="mb-2">Catalogue articles</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Authored by naming variants in the Studio — edit through a model's naming page, not here.
        </MudText>
        <MudTable Items="@_catalogueBacked" Hover="true" Dense="true" Elevation="0" T="Article">
            <HeaderContent>
                <MudTh>Code</MudTh>
                <MudTh>Model</MudTh>
                <MudTh>Element</MudTh>
                <MudTh>Variant code</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Code">@context.AssignedCode</MudTd>
                <MudTd DataLabel="Model">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/studio/{context.ModelCode}")">@context.ModelCode</MudButton>
                </MudTd>
                <MudTd DataLabel="Element">@context.ElementCode</MudTd>
                <MudTd DataLabel="Variant code">@context.VariantCode</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Text="No catalogue articles yet." />
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<Article> _standalone = [];
    private List<Article> _catalogueBacked = [];
    private List<Supplier> _suppliers = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _suppliers = await Parties.SuppliersAsync();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Loading failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ReloadAsync()
    {
        var articles = await AuthoringCatalogueStore.LoadArticlesAsync();
        _standalone = articles.Where(a => !a.IsCatalogueBacked()).ToList();
        _catalogueBacked = articles.Where(a => a.IsCatalogueBacked()).ToList();
    }

    private bool UnknownSupplier(Article article) =>
        article.SupplierRef is not null && !_suppliers.Any(s => s.Code == article.SupplierRef);

    private async Task AddAsync()
    {
        var parameters = new DialogParameters<StandaloneArticleDialog> { { d => d.SubmitLabel, "Add" } };
        var dialogRef = await DialogService.ShowAsync<StandaloneArticleDialog>("Add article", parameters);
        await ApplyAsync(dialogRef, article => ArticleAuthoringService.AddStandaloneAsync(article));
    }

    private async Task EditAsync(Article existing)
    {
        var parameters = new DialogParameters<StandaloneArticleDialog> { { d => d.Article, existing }, { d => d.SubmitLabel, "Save" } };
        var dialogRef = await DialogService.ShowAsync<StandaloneArticleDialog>("Edit article", parameters);
        await ApplyAsync(dialogRef, article => ArticleAuthoringService.UpdateStandaloneAsync(existing.Id, article));
    }

    private async Task DeleteAsync(Article existing)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete article", $"Delete '{existing.AssignedCode}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) { return; }
        try
        {
            await ArticleAuthoringService.DeleteStandaloneAsync(existing.Id);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task ApplyAsync(IDialogReference dialogRef, Func<Article, Task> apply)
    {
        var dialogResult = await dialogRef.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not Article article) { return; }
        try
        {
            await apply(article);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }
}
