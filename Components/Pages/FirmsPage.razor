@page "/firms"
@attribute [Authorize(Roles = Roles.Admin)]
@using CheapFurniturePlanner.Components.Firms
@inject FirmService Firms
@inject PartyService Parties
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Firms</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <PageHeader Kicker="FIRMS" Title="Manage firms">
        <Actions>
            @if (_firms.Count > 0)
            {
                <ProgressButton OnClick="AddFirmAsync" StartIcon="@Icons.Material.Filled.Add">Add firm</ProgressButton>
            }
        </Actions>
    </PageHeader>

    <MudPaper Class="pa-6" Elevation="0">
        <MudTextField T="string" Value="_search" ValueChanged="@((string v) => _search = v)" Label="Search"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" Class="mb-4" />
        <MudTable Items="@FilteredFirms" Hover="true" Dense="true" Loading="@_loading">
            <HeaderContent>
                <MudTh>Code</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>VAT</MudTh>
                <MudTh>Collections</MudTh>
                <MudTh>Default</MudTh>
                <MudTh />
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Code">@context.Code</MudTd>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="VAT">@context.VatNumber</MudTd>
                <MudTd DataLabel="Collections">@_collectionCounts.GetValueOrDefault(context.Id)</MudTd>
                <MudTd DataLabel="Default">
                    @if (context.IsDefault)
                    {
                        <StatusChip Color="@StatusColors.ForActive(true)" Value="Default" />
                    }
                    else
                    {
                        <ProgressButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => SetDefaultAsync(context))">Make default</ProgressButton>
                    }
                </MudTd>
                <MudTd>
                    <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                        <ProgressButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => EditCollectionsAsync(context))">Collections</ProgressButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Title="Edit firm"
                                       OnClick="@(() => EditFirmAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Title="Delete firm"
                                       OnClick="@(() => DeleteFirmAsync(context))" />
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                @if (_firms.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.AccountBalance" Text="No firms yet"
                                ActionText="Add firm" OnAction="AddFirmAsync" />
                }
                else
                {
                    <EmptyState Icon="@Icons.Material.Filled.SearchOff" Text="No firms match your search." />
                }
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<Firm> _firms = [];
    private Dictionary<int, int> _collectionCounts = [];
    private List<Region> _regions = [];
    private bool _loading;
    private string _search = "";

    private IEnumerable<Firm> FilteredFirms => string.IsNullOrWhiteSpace(_search)
        ? _firms
        : _firms.Where(f => f.Code.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || f.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
            _regions = await Parties.RegionsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Loading failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _firms = await Firms.FirmsAsync();
            _collectionCounts = (await Firms.AllCollectionsAsync())
                .GroupBy(c => c.FirmId).ToDictionary(g => g.Key, g => g.Count());
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddFirmAsync()
    {
        var parameters = new DialogParameters<FirmDialog> { { d => d.Regions, _regions }, { d => d.SubmitLabel, "Add" } };
        var dialog = await DialogService.ShowAsync<FirmDialog>("Add firm", parameters);
        if (await dialog.Result is { Canceled: false, Data: Firm firmValues })
        {
            try { await Firms.AddFirmAsync(firmValues); }
            catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
            await ReloadAsync();
        }
    }

    private async Task EditFirmAsync(Firm firm)
    {
        var parameters = new DialogParameters<FirmDialog> { { d => d.Firm, firm }, { d => d.Regions, _regions } };
        var dialog = await DialogService.ShowAsync<FirmDialog>("Edit firm", parameters);
        if (await dialog.Result is { Canceled: false, Data: Firm firmValues })
        {
            try { await Firms.UpdateFirmAsync(firm.Id, firmValues); }
            catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
            await ReloadAsync();
        }
    }

    private async Task SetDefaultAsync(Firm firm)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Change default firm",
            $"Make '{firm.Name}' the default firm? Documents without a routed firm will use it.",
            yesText: "Make default", cancelText: "Cancel");
        if (confirmed != true) { return; }
        try { await Firms.SetDefaultAsync(firm.Id); }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
        await ReloadAsync();
    }

    private async Task DeleteFirmAsync(Firm firm)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete firm",
            $"Delete firm '{firm.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) { return; }
        try { await Firms.DeleteFirmAsync(firm.Id); }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
        await ReloadAsync();
    }

    private async Task EditCollectionsAsync(Firm firm)
    {
        var parameters = new DialogParameters<CollectionsDialog> { { d => d.Firm, firm } };
        var dialog = await DialogService.ShowAsync<CollectionsDialog>($"Collections — {firm.Name}", parameters);
        await dialog.Result;
        await ReloadAsync();
    }
}
