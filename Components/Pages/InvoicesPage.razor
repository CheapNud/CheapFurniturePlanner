@page "/invoices"
@using CheapFurniturePlanner.Auth
@using CheapFurniturePlanner.Models
@using CheapFurniturePlanner.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = Roles.AdminOrOffice)]
@inject InvoicingService Invoicing
@inject UblExport Exporter
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Invoices</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <PageHeader Kicker="INVOICES" Title="Manage invoices">
        <Actions>
            <ProgressButton StartIcon="@Icons.Material.Filled.Code" OnClick="ExportNewAsync">Export new</ProgressButton>
        </Actions>
    </PageHeader>

    <MudPaper Class="pa-6 mb-6" Elevation="0">
        <MudTextField T="string" Value="_search" ValueChanged="@((string v) => _search = v)" Label="Search"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" Class="mb-4" />
        <MudTable T="Invoice" Items="@FilteredInvoices" Hover="true" Dense="true" Loading="@_loading"
                  OnRowClick="@((TableRowClickEventArgs<Invoice> args) => Navigation.NavigateTo($"/invoices/{args.Item!.Id}"))">
            <HeaderContent>
                <MudTh>Invoice</MudTh>
                <MudTh>Order</MudTh>
                <MudTh>Consumer</MudTh>
                <MudTh>Issued</MudTh>
                <MudTh>Gross</MudTh>
                <MudTh>Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Invoice">@context.InvoiceNumber</MudTd>
                <MudTd DataLabel="Order">@context.Order?.OrderNumber</MudTd>
                <MudTd DataLabel="Consumer">@context.Order?.Consumer?.Name</MudTd>
                <MudTd DataLabel="Issued">@context.IssuedAt.ToString("yyyy-MM-dd")</MudTd>
                <MudTd DataLabel="Gross">@context.GrossTotal.ToString("C2")</MudTd>
                <MudTd DataLabel="Status">
                    <StatusChip Color="@StatusColors.ForPaid(context.IsPaid)" Value="@(context.IsPaid ? "Paid" : "Open")" />
                    @if (context.CreditNotes.Count > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary">Credited</MudChip>
                    }
                    @if (context.ExportedAt is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">Exported</MudChip>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                @if (_invoices.Count == 0)
                {
                    <EmptyState Text="No invoices yet" />
                }
                else
                {
                    <EmptyState Icon="@Icons.Material.Filled.SearchOff" Text="No invoices match your search." />
                }
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>

    <MudPaper Class="pa-6" Elevation="0">
        <MudText Typo="Typo.h6" Class="mb-2">VAT rates</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudTextField T="string" @bind-Value="_newMarketCode" Label="Market" />
            <MudNumericField T="decimal" @bind-Value="_newRatePercent" Label="Rate %" Min="0" Max="100" />
            <ProgressButton Variant="Variant.Text" OnClick="SaveRateAsync">Save</ProgressButton>
        </MudStack>
        <MudTable T="MarketVatRate" Items="_vatRates" Dense="true" Loading="@_loading">
            <HeaderContent>
                <MudTh>Market</MudTh>
                <MudTh>Rate %</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Market">@context.MarketCode</MudTd>
                <MudTd DataLabel="Rate %">@context.RatePercent.ToString("0.##")</MudTd>
                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Title="Delete rate" OnClick="@(() => DeleteRateAsync(context.Id))" /></MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Text="No VAT rates yet" />
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<Invoice> _invoices = [];
    private List<MarketVatRate> _vatRates = [];
    private string _newMarketCode = "";
    private decimal _newRatePercent = 21m;
    private bool _loading;
    private string _search = "";

    private IEnumerable<Invoice> FilteredInvoices => string.IsNullOrWhiteSpace(_search)
        ? _invoices
        : _invoices.Where(i => i.InvoiceNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (i.Order?.OrderNumber ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (i.Order?.Consumer?.Name ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Loading failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _invoices = await Invoicing.ListInvoicesAsync();
            _vatRates = await Invoicing.VatRatesAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveRateAsync()
    {
        try
        {
            await Invoicing.SetVatRateAsync(_newMarketCode, _newRatePercent);
            _newMarketCode = "";
            await LoadAsync();
        }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }

    private async Task DeleteRateAsync(int vatRateId)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete rate", "Delete this VAT rate?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) { return; }
        try
        {
            await Invoicing.DeleteVatRateAsync(vatRateId);
            await LoadAsync();
        }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }

    private async Task ExportNewAsync()
    {
        try
        {
            var writtenPaths = await Exporter.ExportNewAsync();
            Snackbar.Add(writtenPaths.Count == 0 ? "Nothing new to export." : $"Exported {writtenPaths.Count} document(s).", Severity.Success);
            await LoadAsync();
        }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
        catch (IOException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }
}
