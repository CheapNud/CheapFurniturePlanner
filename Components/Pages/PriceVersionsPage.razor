@page "/studio/prices"
@attribute [Authorize(Roles = Roles.AdminOrOffice)]
@using CheapFurniturePlanner.Components.Studio
@using CheapFurniturePlanner.Services

@inject PriceVersionService PriceVersionService
@inject CatalogueExport Exporter
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Price versions</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">Price versions</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Publish"
                   OnClick="@PublishAsync">
            Publish new version
        </MudButton>
    </MudStack>
    @if (_pending)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">Unpublished price changes — publish a new version to apply them.</MudAlert>
    }

@if (_versions is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_versions.Count == 0)
{
    <EmptyState Text="No price versions yet." ActionText="Publish new version" OnAction="@PublishAsync" />
}
else
{
    <MudTable Items="@_versions" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Version</MudTh>
            <MudTh>Effective</MudTh>
            <MudTh>Published</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Hash</MudTh>
            <MudTh />
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Version">@context.Version</MudTd>
            <MudTd DataLabel="Effective">@context.EffectiveDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Published">@context.PublishedAt.ToString("yyyy-MM-dd HH:mm")</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@StatusColors.For(context.Status)">@context.Status</MudChip>
            </MudTd>
            <MudTd DataLabel="Hash">@ShortHash(context.ContentHash)</MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                    <MudButton Size="Size.Small" OnClick="@(() => ExportCsvAsync(context.Version))">Export CSV</MudButton>
                    <MudButton Size="Size.Small" OnClick="@(() => ExportJsonAsync(context.Version))">Export JSON</MudButton>
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
}
</MudContainer>

@code {
    private IReadOnlyList<PriceVersionInfo>? _versions;
    private bool _pending;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Loading failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ReloadAsync()
    {
        _versions = await PriceVersionService.ListVersionsAsync();
        _pending = await PriceVersionService.HasPendingChangesAsync();
    }

    private static string ShortHash(string hash) => hash.Length > 12 ? hash[..12] : hash;

    private async Task PublishAsync()
    {
        var dialogRef = await DialogService.ShowAsync<PublishVersionDialog>("Publish new version");
        var dialogResult = await dialogRef.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not DateTime effectiveDate)
        {
            return;
        }
        try
        {
            await PriceVersionService.PublishNewVersionAsync(effectiveDate);
            Snackbar.Add($"Published — effective {effectiveDate:yyyy-MM-dd}.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task ExportCsvAsync(string version)
    {
        try
        {
            var filePath = await Exporter.GenerateCsvAsync(version);
            Snackbar.Add($"Exported {filePath}", Severity.Success);
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ExportJsonAsync(string version)
    {
        try
        {
            var filePath = await Exporter.GenerateJsonAsync(version);
            Snackbar.Add($"Exported {filePath}", Severity.Success);
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
