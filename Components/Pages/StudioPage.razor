@page "/studio"
@attribute [Authorize(Roles = Roles.AdminOrOffice)]
@using CheapFurniturePlanner.Catalogue
@using CheapFurniturePlanner.Domain.Catalog

@inject ModelPublishService ModelPublishService
@inject ModelAuthoringService ModelAuthoringService
@inject AuthoringCatalogueStore AuthoringCatalogueStore
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Catalog Studio</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <PageHeader Kicker="STUDIO" Title="Catalog Studio">
        <Actions>
            @if (_models.Count > 0)
            {
                <ProgressButton StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenNewModelDialogAsync())">
                    New model
                </ProgressButton>
            }
        </Actions>
    </PageHeader>
    <MudAlert Severity="Severity.Info" Class="mb-4">Only released (Active) models appear in the catalogue and planner.</MudAlert>

    <MudPaper Class="pa-6" Elevation="0">
        <MudTable Items="@_models" Hover="true" Dense="true" Loading="@_loading">
            <HeaderContent>
                <MudTh>Code</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>State</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Code">@context.Code</MudTd>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="State">
                    <StatusChip Color="@StatusColors.For(context.State)" Value="@context.State.ToString()" />
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Info"
                                   OnClick="@(() => Navigation.NavigateTo($"/studio/{context.Code}"))">
                            Name variants
                        </MudButton>
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Text"
                                   Color="Color.Info"
                                   OnClick="@(() => Navigation.NavigateTo($"/studio/{context.Code}/elements"))">
                            Elements
                        </MudButton>
                        <MudSelect T="TradeItemState"
                                   Label="State"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   Value="@context.State"
                                   ValueChanged="@((TradeItemState newState) => ChangeStateAsync(context.Code, newState))">
                            @foreach (var state in Enum.GetValues<TradeItemState>())
                            {
                                <MudSelectItem T="TradeItemState" Value="@state">@state</MudSelectItem>
                            }
                        </MudSelect>
                        <ProgressButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => OpenEditModelDialogAsync(context.Code))">
                            Edit
                        </ProgressButton>
                        <ProgressButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                        Disabled="@(context.State == TradeItemState.Active)"
                                        OnClick="@(() => DeleteModelAsync(context.Code))">
                            Delete
                        </ProgressButton>
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Icon="@Icons.Material.Filled.Tag" Text="No models yet." ActionText="New model" OnAction="@(() => OpenNewModelDialogAsync())" />
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<AuthoringModel> _models = [];
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Loading failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _models = (await ModelPublishService.GetAuthoringModelsAsync()).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    // Free-flow state change: always reload afterwards, whether SetStateAsync succeeded or reverted -
    // that's how the row ends up showing the model's ACTUAL persisted state either way.
    private async Task ChangeStateAsync(string modelCode, TradeItemState newState)
    {
        try
        {
            await ModelPublishService.SetStateAsync(modelCode, newState);
            Snackbar.Add($"Model '{modelCode}' set to {newState}.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task OpenNewModelDialogAsync()
    {
        var existingCodes = (_models ?? []).Select(model => model.Code).ToList();
        var parameters = new DialogParameters<NewModelDialog>
        {
            { dialog => dialog.ExistingCodes, existingCodes }
        };
        var dialogRef = await DialogService.ShowAsync<NewModelDialog>("New model", parameters);
        var dialogResult = await dialogRef.Result;
        if (dialogResult is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task OpenEditModelDialogAsync(string modelCode)
    {
        var model = await AuthoringCatalogueStore.LoadModelAsync(modelCode);
        if (model is null)
        {
            Snackbar.Add($"Model '{modelCode}' not found.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters<EditModelDialog>
        {
            { dialog => dialog.Code, model.Code },
            { dialog => dialog.Name, model.Name },
            { dialog => dialog.Collection, model.CollectionCode },
            { dialog => dialog.ModelType, model.ModelType }
        };
        var dialogRef = await DialogService.ShowAsync<EditModelDialog>("Edit model", parameters);
        var dialogResult = await dialogRef.Result;
        if (dialogResult is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task DeleteModelAsync(string modelCode)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete model",
            $"'{modelCode}' will be permanently deleted. Continue?",
            yesText: "Delete",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await ModelAuthoringService.DeleteAsync(modelCode);
            Snackbar.Add($"Model '{modelCode}' deleted.", Severity.Success);
            await ReloadAsync();
        }
        catch (ModelActiveException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
