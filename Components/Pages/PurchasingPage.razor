@page "/purchasing"
@using CheapFurniturePlanner.Auth
@using CheapFurniturePlanner.Models
@using CheapFurniturePlanner.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = Roles.AdminOrOffice)]
@inject PurchasingService Purchasing
@inject PartyService Parties
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Purchasing</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <PageHeader Kicker="PURCHASING" Title="Purchasing">
        <Actions>
            @* Canon deviation (see EmptyState below): Generate is a recurring sweep action, always
               available - not a genuine per-record "Add", so it stays visible regardless of whether
               any purchase orders exist yet. *@
            <ProgressButton OnClick="GenerateOrdersAsync" StartIcon="@Icons.Material.Filled.Sync">Generate orders</ProgressButton>
        </Actions>
    </PageHeader>

    @if (_unresolvedModelCodes.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-6">
            <MudText Class="mb-2">Unresolved:</MudText>
            @foreach (var modelCode in _unresolvedModelCodes)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
                    <MudText>@modelCode</MudText>
                    <ProgressButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => MarkInHouseAsync(modelCode))">Mark in-house</ProgressButton>
                </MudStack>
            }
        </MudAlert>
    }

    @if (_inHouseModelCodes.Count > 0)
    {
        <MudPaper Class="pa-6 mb-6" Elevation="0">
            <MudText Typo="Typo.h6" Class="mb-2">In-house models</MudText>
            @foreach (var modelCode in _inHouseModelCodes)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
                    <MudText>@modelCode</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Title="Unmark in-house" OnClick="@(() => UnmarkInHouseAsync(modelCode))" />
                </MudStack>
            }
        </MudPaper>
    }

    <MudPaper Class="pa-6" Elevation="0">
        <MudTable T="SupplierOrder" Items="_orders" Hover="true" Dense="true" Loading="@_loading"
                  OnRowClick="@((TableRowClickEventArgs<SupplierOrder> args) => Navigation.NavigateTo($"/purchasing/{args.Item!.Id}"))">
            <HeaderContent>
                <MudTh>PO number</MudTh>
                <MudTh>Supplier</MudTh>
                <MudTh>State</MudTh>
                <MudTh>Units (outstanding / total)</MudTh>
                <MudTh>Created</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="PO number">@context.PoNumber</MudTd>
                <MudTd DataLabel="Supplier">@context.Supplier?.Name</MudTd>
                <MudTd DataLabel="State"><StatusChip Color="@StatusColors.For(context.State)" Value="@context.State.ToString()" /></MudTd>
                <MudTd DataLabel="Units (outstanding / total)">@Outstanding(context) / @context.Units.Count</MudTd>
                <MudTd DataLabel="Created">@context.CreatedAt.ToString("yyyy-MM-dd")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                @* Canon deviation: EmptyState normally carries the page's own "Add" CTA, but a purchase
                   order is never hand-added - the sweep button above IS the action, for an empty list
                   same as a full one, so it stays visible and this EmptyState has no ActionText of
                   its own. *@
                <EmptyState Text="No purchase orders yet" />
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<SupplierOrder> _orders = [];
    private List<string> _unresolvedModelCodes = [];
    private List<string> _inHouseModelCodes = [];
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Loading failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _orders = await Purchasing.ListOrdersAsync();
            _unresolvedModelCodes = await Purchasing.UnresolvedModelCodesAsync();
            _inHouseModelCodes = await Parties.InHouseModelCodesAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task MarkInHouseAsync(string modelCode)
    {
        try { await Parties.MarkModelInHouseAsync(modelCode); await LoadAsync(); }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }

    private async Task UnmarkInHouseAsync(string modelCode)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Unmark in-house",
            $"Unmark '{modelCode}' as produced in-house? It will need a supplier mapping again to resolve.",
            yesText: "Unmark", cancelText: "Cancel");
        if (confirmed != true) { return; }
        try { await Parties.UnmarkModelInHouseAsync(modelCode); await LoadAsync(); }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }

    private static int Outstanding(SupplierOrder order) =>
        order.Units.Count(u => u.State is not (ProductionUnitState.Arrived or ProductionUnitState.Delivered or ProductionUnitState.Cancelled));

    private async Task GenerateOrdersAsync()
    {
        try
        {
            var sweep = await Purchasing.GenerateOrdersAsync();
            var message = $"Created/updated {sweep.SupplierOrderIds.Count} purchase order(s).";
            if (sweep.UnresolvedModelCodes.Count > 0) { message += $" Unresolved: {string.Join(", ", sweep.UnresolvedModelCodes)}"; }
            Snackbar.Add(message, sweep.UnresolvedModelCodes.Count > 0 ? Severity.Warning : Severity.Success);
            await LoadAsync();
        }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }
}
