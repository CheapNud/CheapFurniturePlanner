@page "/orders"
@attribute [Authorize(Roles = Roles.AdminOrOffice)]
@using CheapFurniturePlanner.Components.Orders
@using CheapFurniturePlanner.Ui
@inject OrderEntryService OrderEntryService
@inject ProductionUnitService Units
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Orders</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">Orders</MudText>
        <MudSpacer />
        @if (_orders.Count > 0)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => NewOrderAsync())">
                New order
            </MudButton>
        }
    </MudStack>

    @if (_orders.Count == 0)
    {
        <EmptyState Text="No orders yet" ActionText="New order" OnAction="@(() => NewOrderAsync())" />
    }
    else
    {
        <MudTable Items="@_orders" Hover="true" Dense="true" T="Order"
                  OnRowClick="@((TableRowClickEventArgs<Order> args) => Navigation.NavigateTo($"/orders/{args.Item!.Id}"))">
            <HeaderContent>
                <MudTh>Order number</MudTh>
                <MudTh>Seller</MudTh>
                <MudTh>Consumer</MudTh>
                <MudTh>State</MudTh>
                <MudTh>Production</MudTh>
                <MudTh>Lines</MudTh>
                <MudTh>Total</MudTh>
                <MudTh>Pinned version</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Order number">@context.OrderNumber</MudTd>
                <MudTd DataLabel="Seller">@context.Seller?.Name</MudTd>
                <MudTd DataLabel="Consumer">@context.Consumer?.Name</MudTd>
                <MudTd DataLabel="State">
                    <MudChip T="string" Size="Size.Small" Color="@StatusColors.For(context.State)">@context.State</MudChip>
                </MudTd>
                <MudTd DataLabel="Production">
                    @if (_phases.GetValueOrDefault(context.Id) is ProductionPhase orderPhase)
                    {
                        <MudChip T="string" Size="Size.Small" Color="@StatusColors.For(orderPhase)">@PhaseLabel(orderPhase)</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Lines">@context.Lines.Count</MudTd>
                <MudTd DataLabel="Total">@OrderEntryService.OrderTotal(context).ToString("C2")</MudTd>
                <MudTd DataLabel="Pinned version">@(context.PinnedCatalogueVersion ?? "—")</MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@code {
    private List<Order> _orders = [];
    private Dictionary<int, ProductionPhase?> _phases = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Loading failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ReloadAsync()
    {
        _orders = await OrderEntryService.ListOrdersAsync();
        _phases = await Units.PhasesForOrdersAsync(_orders.Select(o => o.Id).ToList());
    }

    private static string PhaseLabel(ProductionPhase orderPhase) => orderPhase switch
    {
        ProductionPhase.InProduction => "In production",
        ProductionPhase.Ready => "Ready",
        _ => "Delivered",
    };

    private async Task NewOrderAsync()
    {
        var dialogRef = await DialogService.ShowAsync<NewOrderDialog>("New order");
        var dialogResult = await dialogRef.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not NewOrderDialog.NewOrderResult result)
        {
            return;
        }
        try
        {
            var order = await OrderEntryService.CreateOrderAsync(result.SellerId, result.ConsumerId, result.MarketCode);
            Navigation.NavigateTo($"/orders/{order.Id}");
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
