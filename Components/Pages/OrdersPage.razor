@page "/orders"
@attribute [Authorize(Roles = Roles.AdminOrOffice)]
@using CheapFurniturePlanner.Components.Orders
@using CheapFurniturePlanner.Ui
@inject OrderEntryService OrderEntryService
@inject ProductionUnitService Units
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Orders</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <PageHeader Kicker="ORDERS" Title="Manage orders">
        <Actions>
            @if (_orders.Count > 0)
            {
                <ProgressButton OnClick="NewOrderAsync" StartIcon="@Icons.Material.Filled.Add">New order</ProgressButton>
            }
        </Actions>
    </PageHeader>

    <MudPaper Class="pa-6" Elevation="0">
        <MudTextField T="string" Value="_search" ValueChanged="@((string v) => _search = v)" Label="Search"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" Class="mb-4" />
        <MudTable Items="@FilteredOrders" Hover="true" Dense="true" T="Order" Loading="@_loading"
                  OnRowClick="@((TableRowClickEventArgs<Order> args) => Navigation.NavigateTo($"/orders/{args.Item!.Id}"))">
            <HeaderContent>
                <MudTh>Order number</MudTh>
                <MudTh>Seller</MudTh>
                <MudTh>Consumer</MudTh>
                <MudTh>State</MudTh>
                <MudTh>Production</MudTh>
                <MudTh>Lines</MudTh>
                <MudTh>Total</MudTh>
                <MudTh>Pinned version</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Order number">@context.OrderNumber</MudTd>
                <MudTd DataLabel="Seller">@context.Seller?.Name</MudTd>
                <MudTd DataLabel="Consumer">@context.Consumer?.Name</MudTd>
                <MudTd DataLabel="State">
                    <StatusChip Color="@StatusColors.For(context.State)" Value="@context.State.ToString()" />
                </MudTd>
                <MudTd DataLabel="Production">
                    @if (_phases.GetValueOrDefault(context.Id) is ProductionPhase orderPhase)
                    {
                        <StatusChip Color="@StatusColors.For(orderPhase)" Value="@orderPhase.ToString()" />
                    }
                </MudTd>
                <MudTd DataLabel="Lines">@context.Lines.Count</MudTd>
                <MudTd DataLabel="Total">@OrderEntryService.OrderTotal(context).ToString("C2")</MudTd>
                <MudTd DataLabel="Pinned version">@(context.PinnedCatalogueVersion ?? "—")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                @if (_orders.Count == 0)
                {
                    <EmptyState Text="No orders yet" ActionText="New order" OnAction="NewOrderAsync" />
                }
                else
                {
                    <EmptyState Icon="@Icons.Material.Filled.SearchOff" Text="No orders match your search." />
                }
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<Order> _orders = [];
    private Dictionary<int, ProductionPhase?> _phases = [];
    private bool _loading;
    private string _search = "";

    private IEnumerable<Order> FilteredOrders => string.IsNullOrWhiteSpace(_search)
        ? _orders
        : _orders.Where(o => o.OrderNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (o.Seller?.Name ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (o.Consumer?.Name ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Loading failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _orders = await OrderEntryService.ListOrdersAsync();
            _phases = await Units.PhasesForOrdersAsync(_orders.Select(o => o.Id).ToList());
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task NewOrderAsync()
    {
        var dialogRef = await DialogService.ShowAsync<NewOrderDialog>("New order");
        var dialogResult = await dialogRef.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not NewOrderDialog.NewOrderResult result)
        {
            return;
        }
        try
        {
            var order = await OrderEntryService.CreateOrderAsync(result.SellerId, result.ConsumerId, result.MarketCode);
            Navigation.NavigateTo($"/orders/{order.Id}");
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
