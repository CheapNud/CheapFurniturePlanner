@page "/trips/{Id:int}"
@using CheapFurniturePlanner.Auth
@using CheapFurniturePlanner.Models
@using CheapFurniturePlanner.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = Roles.WarehouseStaff)]
@inject ProductionUnitService Units
@inject PartyService Parties
@inject TripLoadListPdf LoadListPdf
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Trip</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @if (_trip is null)
    {
        <MudText>Loading…</MudText>
    }
    else
    {
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Title="Back to trips" OnClick="@(() => Navigation.NavigateTo("/trips"))" Class="mb-2" />
        <PageHeader Kicker="TRIPS" Title="@_trip.TripCode">
            <Actions>
                <StatusChip Color="@StatusColors.For(_trip.State)" Value="@_trip.State.ToString()" />
                <ProgressButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="GenerateLoadListAsync">Load list</ProgressButton>
                @if (IsPlanning)
                {
                    <ProgressButton Variant="Variant.Text" Color="Color.Error" Disabled="@(_trip.Units.Count > 0)" OnClick="DeleteAsync">Delete</ProgressButton>
                    <MudTooltip Text="@string.Join(", ", ExpectedUnitCodes)">
                        <ProgressButton StartIcon="@Icons.Material.Filled.LocalShipping" Disabled="@(ExpectedUnitCodes.Count > 0)" OnClick="DepartAsync">Depart</ProgressButton>
                    </MudTooltip>
                }
            </Actions>
        </PageHeader>

        <MudGrid>
            <MudItem xs="12" md="5">
                <MudPaper Class="pa-6 mb-6" Elevation="0">
                    <MudText Typo="Typo.h6" Class="mb-2">Trip</MudText>
                    <MudDatePicker Label="Departure date" Date="_departureDate" DateChanged="OnFieldsChangedDate" Disabled="@(!IsPlanning)" />
                    <MudTextField T="string" Label="Truck" Value="_truckName" ValueChanged="OnTruckChanged" Disabled="@(!IsPlanning)" />
                    <MudTextField T="string" Label="Driver" Value="_driverName" ValueChanged="OnDriverChanged" Disabled="@(!IsPlanning)" />
                    @* Clearable is the one clear affordance (matches every other select in the app) -
                       a manual "—" item here used to duplicate it, which read as two competing ways
                       to clear the same field. *@
                    <MudSelect T="int?" Label="Region" Value="_regionId" ValueChanged="OnRegionChanged" Disabled="@(!IsPlanning)" Clearable="true">
                        @foreach (var region in _regions)
                        {
                            <MudSelectItem T="int?" Value="@((int?)region.Id)">@region.Code — @region.Name</MudSelectItem>
                        }
                    </MudSelect>
                    @if (_trip.DepartedAt is DateTime departedAt)
                    {
                        <MudText Typo="Typo.body2" Class="mt-2">Departed @departedAt.ToString("yyyy-MM-dd HH:mm")</MudText>
                    }
                    @if (_trip.CompletedAt is DateTime completedAt)
                    {
                        <MudText Typo="Typo.body2" Class="mt-1">Completed @completedAt.ToString("yyyy-MM-dd HH:mm")</MudText>
                    }
                </MudPaper>

                @if (IsPlanning)
                {
                    <MudPaper Class="pa-6" Elevation="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudText Typo="Typo.h6">Plannable units</MudText>
                            <MudSpacer />
                            <MudSwitch T="bool" Value="_showAllRegions" ValueChanged="OnShowAllRegionsChanged" Label="All regions" Color="Color.Primary" />
                        </MudStack>
                        @if (_assignable.Count == 0)
                        {
                            <EmptyState Text="Nothing plannable right now" />
                        }
                        else
                        {
                            @foreach (var candidate in _assignable)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                                    <StatusChip Color="@StatusColors.For(candidate.State)" Value="@candidate.State.ToString()" />
                                    <MudText>@candidate.UnitCode — @candidate.Order?.Consumer?.Name</MudText>
                                    <MudText Typo="Typo.caption">@candidate.Order?.DeliveryAddress?.Region?.Code</MudText>
                                    <MudSpacer />
                                    <ProgressButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => AssignAsync(candidate.Id))">Load</ProgressButton>
                                </MudStack>
                            }
                        }
                    </MudPaper>
                }
            </MudItem>

            <MudItem xs="12" md="7">
                <MudPaper Class="pa-6" Elevation="0">
                    <MudText Typo="Typo.h6" Class="mb-2">Load list</MudText>
                    <MudTable T="ProductionUnit" Items="_trip.Units" Dense="true" Loading="@_loading">
                        <HeaderContent>
                            <MudTh>Position</MudTh>
                            <MudTh>Unit</MudTh>
                            <MudTh>Order</MudTh>
                            <MudTh>Consumer</MudTh>
                            <MudTh>Promise</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Position">
                                <MudNumericField T="int?" Value="@context.LoadPosition" ValueChanged="@((int? position) => SetPositionAsync(context.Id, position))" Disabled="@(!IsPlanning)" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd DataLabel="Unit">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <StatusChip Color="@StatusColors.For(context.State)" Value="@context.State.ToString()" />
                                    <MudText>@context.UnitCode</MudText>
                                </MudStack>
                            </MudTd>
                            <MudTd DataLabel="Order">@context.Order?.OrderNumber</MudTd>
                            <MudTd DataLabel="Consumer">@context.Order?.Consumer?.Name</MudTd>
                            <MudTd DataLabel="Promise">
                                @if (context.Order?.PromisedDeliveryDate is DateTime promised)
                                {
                                    if (ProductionUnitService.PromiseMissed(promised, _trip.DepartureDate))
                                    {
                                        <StatusChip Color="Color.Warning" Value="@promised.ToString("yyyy-MM-dd")" />
                                    }
                                    else
                                    {
                                        @promised.ToString("yyyy-MM-dd")
                                    }
                                }
                            </MudTd>
                            <MudTd>
                                @if (IsPlanning)
                                {
                                    <ProgressButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ReleaseAsync(context.Id))">Release</ProgressButton>
                                }
                                else if (IsDeparted && context.State == ProductionUnitState.Arrived)
                                {
                                    @if (_failingUnitId == context.Id)
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudTextField T="string" @bind-Value="_failReason" Label="Reason" Immediate="true" Margin="Margin.Dense" />
                                            <ProgressButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => ConfirmFailedAsync(context.Id))">Confirm</ProgressButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="CancelFail">Cancel</MudButton>
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <MudStack Row="true" Spacing="1">
                                            <ProgressButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="@(() => ConfirmDeliveredAsync(context.Id))">Delivered</ProgressButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => StartFail(context.Id))">Failed</MudButton>
                                        </MudStack>
                                    }
                                }
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <EmptyState Text="No units loaded yet" />
                        </NoRecordsContent>
                    </MudTable>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    private Trip? _trip;
    private List<ProductionUnit> _assignable = [];
    private List<Region> _regions = [];
    private DateTime? _departureDate;
    private string? _truckName;
    private string? _driverName;
    private int? _regionId;
    private bool _showAllRegions;
    private int? _failingUnitId;
    private string _failReason = "";
    private bool _loading;

    private bool IsPlanning => _trip!.State == TripState.Planning;
    private bool IsDeparted => _trip!.State == TripState.Departed;
    private List<string> ExpectedUnitCodes => _trip!.Units.Where(u => u.State == ProductionUnitState.Expected).Select(u => u.UnitCode).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _regions = await Parties.RegionsAsync();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Loading failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _trip = await Units.GetTripAsync(Id);
            if (_trip is not null)
            {
                _departureDate = _trip.DepartureDate;
                _truckName = _trip.TruckName;
                _driverName = _trip.DriverName;
                _regionId = _trip.RegionId;
                _failingUnitId = null;
                _failReason = "";
                await ReloadPoolAsync();
            }
        }
        finally
        {
            _loading = false;
        }
        StateHasChanged();
    }

    private async Task ReloadPoolAsync()
    {
        _assignable = _trip!.State == TripState.Planning
            ? await Units.AssignableUnitsAsync(_showAllRegions ? null : _trip.RegionId)
            : [];
    }

    private Task OnFieldsChangedDate(DateTime? departureDate) { _departureDate = departureDate; return SaveFieldsAsync(); }
    private Task OnTruckChanged(string? truckName) { _truckName = truckName; return SaveFieldsAsync(); }
    private Task OnDriverChanged(string? driverName) { _driverName = driverName; return SaveFieldsAsync(); }

    private async Task OnRegionChanged(int? regionId)
    {
        _regionId = regionId;
        _trip!.RegionId = regionId;
        await SaveFieldsAsync();
        await ReloadPoolAsync();
    }

    private async Task OnShowAllRegionsChanged(bool showAll)
    {
        _showAllRegions = showAll;
        await ReloadPoolAsync();
    }

    private async Task SaveFieldsAsync()
    {
        try { await Units.UpdateTripAsync(Id, _departureDate, _truckName, _driverName, _regionId); }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }

    private async Task AssignAsync(int unitId)
    {
        try { await Units.AssignToTripAsync(Id, unitId); await ReloadAsync(); }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }

    private async Task ReleaseAsync(int unitId)
    {
        try { await Units.ReleaseFromTripAsync(unitId); await ReloadAsync(); }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }

    private async Task SetPositionAsync(int unitId, int? position)
    {
        try { await Units.SetLoadPositionAsync(unitId, position); await ReloadAsync(); }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }

    private async Task DepartAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Depart trip",
            $"Depart {_trip!.TripCode} with {_trip.Units.Count} unit(s)?",
            yesText: "Depart", cancelText: "Back");
        if (confirmed != true) { return; }
        try { await Units.DepartAsync(Id); await ReloadAsync(); }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }

    private async Task DeleteAsync()
    {
        try { await Units.DeleteTripAsync(Id); Navigation.NavigateTo("/trips"); }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }

    private async Task GenerateLoadListAsync()
    {
        try
        {
            var filePath = await LoadListPdf.GenerateAsync(Id);
            Snackbar.Add($"Load list written to {filePath}", Severity.Success);
        }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
        catch (IOException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }

    private async Task ConfirmDeliveredAsync(int unitId)
    {
        try { await Units.ConfirmDeliveredAsync(unitId); await ReloadAsync(); }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }

    private void StartFail(int unitId) { _failingUnitId = unitId; _failReason = ""; }

    private void CancelFail() { _failingUnitId = null; _failReason = ""; }

    private async Task ConfirmFailedAsync(int unitId)
    {
        try { await Units.ConfirmFailedAsync(unitId, _failReason); await ReloadAsync(); }
        catch (InvalidOperationException failure) { Snackbar.Add(failure.Message, Severity.Error); }
    }
}
