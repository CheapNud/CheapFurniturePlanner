@page "/parties"
@attribute [Authorize(Roles = Roles.AdminOrOffice)]
@using CheapFurniturePlanner.Components.Orders
@using CheapFurniturePlanner.Components.Parties
@inject PartyService PartyService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Parties</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">Parties</MudText>
        <MudSpacer />
    </MudStack>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
        <MudTabPanel Text="Sellers">
            <MudStack Spacing="3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">Sellers</MudText>
                    @if (_sellers.Count > 0)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddSellerAsync())">
                            Add seller
                        </MudButton>
                    }
                </MudStack>
                @if (_sellers.Count == 0)
                {
                    <EmptyState Text="No sellers yet." ActionText="Add seller" OnAction="@(() => AddSellerAsync())" />
                }
                else
                {
                <MudTable Items="@_sellers" Hover="true" Dense="true" T="Seller">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Multiplier</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Multiplier">@context.Multiplier</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => EditSellerAsync(context))">Edit</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => EditSellerAddressAsync(context))">Address</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteSellerAsync(context))">Delete</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Href="@($"/parties/{context.Id}/discounts")">Discounts</MudButton>
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                }
            </MudStack>
        </MudTabPanel>

        <MudTabPanel Text="Consumers">
            <MudStack Spacing="3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">Consumers</MudText>
                    @if (_consumers.Count > 0)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddConsumerAsync())">
                            Add consumer
                        </MudButton>
                    }
                </MudStack>
                @if (_consumers.Count == 0)
                {
                    <EmptyState Text="No consumers yet." ActionText="Add consumer" OnAction="@(() => AddConsumerAsync())" />
                }
                else
                {
                <MudTable Items="@_consumers" Hover="true" Dense="true" T="Consumer">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Contact</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Contact">@context.Contact</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => EditConsumerAsync(context))">Edit</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => EditConsumerAddressesAsync(context))">Addresses</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteConsumerAsync(context))">Delete</MudButton>
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                }
            </MudStack>
        </MudTabPanel>

        <MudTabPanel Text="Suppliers">
            <MudStack Spacing="3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">Suppliers</MudText>
                    @if (_suppliers.Count > 0)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddSupplierAsync())">
                            Add supplier
                        </MudButton>
                    }
                </MudStack>
                @if (_suppliers.Count == 0)
                {
                    <EmptyState Text="No suppliers yet." ActionText="Add supplier" OnAction="@(() => AddSupplierAsync())" />
                }
                else
                {
                <MudTable Items="@_suppliers" Hover="true" Dense="true" T="Supplier">
                    <HeaderContent>
                        <MudTh>Code</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Address</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Code">@context.Code</MudTd>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Address">@context.Address?.ToOneLine()</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => EditSupplierAsync(context))">Edit</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => EditSupplierModelsAsync(context))">Models</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteSupplierAsync(context))">Delete</MudButton>
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                }
            </MudStack>
        </MudTabPanel>

        <MudTabPanel Text="Regions">
            <MudStack Spacing="3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">Regions</MudText>
                    @if (_regions.Count > 0)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddRegionAsync())">
                            Add region
                        </MudButton>
                    }
                </MudStack>
                @if (_regions.Count == 0)
                {
                    <EmptyState Text="No regions yet." ActionText="Add region" OnAction="@(() => AddRegionAsync())" />
                }
                else
                {
                <MudTable Items="@_regions" Hover="true" Dense="true" T="Region">
                    <HeaderContent>
                        <MudTh>Code</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Code">@context.Code</MudTd>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => EditRegionAsync(context))">Edit</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteRegionAsync(context))">Delete</MudButton>
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                }
            </MudStack>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private List<Seller> _sellers = [];
    private List<Consumer> _consumers = [];
    private List<Supplier> _suppliers = [];
    private List<Region> _regions = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Loading failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ReloadAsync()
    {
        _sellers = await PartyService.SellersAsync();
        _consumers = await PartyService.ConsumersAsync();
        _suppliers = await PartyService.SuppliersAsync();
        _regions = await PartyService.RegionsAsync();
    }

    // --- Sellers ---

    private async Task AddSellerAsync()
    {
        var parameters = new DialogParameters<SellerDialog> { { d => d.SubmitLabel, "Add" } };
        var dialogRef = await DialogService.ShowAsync<SellerDialog>("Add seller", parameters);
        await ApplySellerAsync(dialogRef, seller => PartyService.AddSellerAsync(seller.Name, seller.Multiplier));
    }

    private async Task EditSellerAsync(Seller existing)
    {
        var parameters = new DialogParameters<SellerDialog> { { d => d.Seller, existing }, { d => d.SubmitLabel, "Save" } };
        var dialogRef = await DialogService.ShowAsync<SellerDialog>("Edit seller", parameters);
        await ApplySellerAsync(dialogRef, seller => PartyService.UpdateSellerAsync(existing.Id, seller.Name, seller.Multiplier));
    }

    private async Task DeleteSellerAsync(Seller existing)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete seller", $"Delete '{existing.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) { return; }
        try
        {
            await PartyService.DeleteSellerAsync(existing.Id);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task ApplySellerAsync(IDialogReference dialogRef, Func<Seller, Task> apply)
    {
        var dialogResult = await dialogRef.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not Seller seller) { return; }
        try
        {
            await apply(seller);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task EditSellerAddressAsync(Seller existing)
    {
        var parameters = new DialogParameters<SellerAddressDialog> { { d => d.Address, existing.Address ?? AddressEditor.NewBlankAddress() }, { d => d.Regions, _regions } };
        var dialogRef = await DialogService.ShowAsync<SellerAddressDialog>($"{existing.Name} — address", parameters);
        var dialogResult = await dialogRef.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not Address address) { return; }
        try
        {
            await PartyService.SetSellerAddressAsync(existing.Id, address);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    // --- Consumers ---

    private async Task AddConsumerAsync()
    {
        var parameters = new DialogParameters<ConsumerDialog> { { d => d.SubmitLabel, "Add" } };
        var dialogRef = await DialogService.ShowAsync<ConsumerDialog>("Add consumer", parameters);
        await ApplyConsumerAsync(dialogRef, consumer => PartyService.AddConsumerAsync(consumer.Name, consumer.Contact));
    }

    private async Task EditConsumerAsync(Consumer existing)
    {
        var parameters = new DialogParameters<ConsumerDialog> { { d => d.Consumer, existing }, { d => d.SubmitLabel, "Save" } };
        var dialogRef = await DialogService.ShowAsync<ConsumerDialog>("Edit consumer", parameters);
        await ApplyConsumerAsync(dialogRef, consumer => PartyService.UpdateConsumerAsync(existing.Id, consumer.Name, consumer.Contact));
    }

    private async Task DeleteConsumerAsync(Consumer existing)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete consumer", $"Delete '{existing.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) { return; }
        try
        {
            await PartyService.DeleteConsumerAsync(existing.Id);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task ApplyConsumerAsync(IDialogReference dialogRef, Func<Consumer, Task> apply)
    {
        var dialogResult = await dialogRef.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not Consumer consumer) { return; }
        try
        {
            await apply(consumer);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task EditConsumerAddressesAsync(Consumer existing)
    {
        var parameters = new DialogParameters<ConsumerAddressBookDialog> { { d => d.Consumer, existing }, { d => d.Regions, _regions } };
        var dialogRef = await DialogService.ShowAsync<ConsumerAddressBookDialog>($"{existing.Name} — addresses", parameters);
        await dialogRef.Result;
        await ReloadAsync();
    }

    // --- Suppliers ---

    private async Task AddSupplierAsync()
    {
        var parameters = new DialogParameters<SupplierDialog> { { d => d.SubmitLabel, "Add" }, { d => d.Regions, _regions } };
        var dialogRef = await DialogService.ShowAsync<SupplierDialog>("Add supplier", parameters);
        var dialogResult = await dialogRef.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not Supplier supplier) { return; }
        try
        {
            var added = await PartyService.AddSupplierAsync(supplier.Code, supplier.Name);
            // A brand-new supplier never has an address to clear - a null Address here just means
            // the dialog's "Add address" affordance was never used, same as blank fields.
            if (!string.IsNullOrWhiteSpace(supplier.Address?.Street) || !string.IsNullOrWhiteSpace(supplier.Address?.City))
            {
                await PartyService.SetSupplierAddressAsync(added.Id, supplier.Address!);
            }
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task EditSupplierAsync(Supplier existing)
    {
        var parameters = new DialogParameters<SupplierDialog> { { d => d.Supplier, existing }, { d => d.SubmitLabel, "Save" }, { d => d.Regions, _regions } };
        var dialogRef = await DialogService.ShowAsync<SupplierDialog>("Edit supplier", parameters);
        var dialogResult = await dialogRef.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not Supplier supplier) { return; }
        try
        {
            await PartyService.UpdateSupplierAsync(existing.Id, supplier.Code, supplier.Name);
            // Addresses 4: SupplierDialog returns Address == null only for a deliberate "Clear
            // address" click (never for blank-but-untouched fields, which stay a real object) - that
            // is the one case that must actually wipe the stored address rather than leave it alone.
            if (supplier.Address is null)
            {
                if (existing.Address is not null) { await PartyService.ClearSupplierAddressAsync(existing.Id); }
            }
            else if (!string.IsNullOrWhiteSpace(supplier.Address.Street) || !string.IsNullOrWhiteSpace(supplier.Address.City))
            {
                await PartyService.SetSupplierAddressAsync(existing.Id, supplier.Address);
            }
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task EditSupplierModelsAsync(Supplier existing)
    {
        var parameters = new DialogParameters<SupplierModelsDialog> { { d => d.SupplierId, existing.Id } };
        var dialogRef = await DialogService.ShowAsync<SupplierModelsDialog>($"{existing.Name} — models", parameters);
        await dialogRef.Result;
    }

    private async Task DeleteSupplierAsync(Supplier existing)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete supplier", $"Delete '{existing.Name}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) { return; }
        try
        {
            await PartyService.DeleteSupplierAsync(existing.Id);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    // --- Regions ---

    private async Task AddRegionAsync()
    {
        var parameters = new DialogParameters<RegionDialog> { { d => d.SubmitLabel, "Add" } };
        var dialogRef = await DialogService.ShowAsync<RegionDialog>("Add region", parameters);
        var dialogResult = await dialogRef.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not Region region) { return; }
        try
        {
            await PartyService.AddRegionAsync(region.Code, region.Name);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task EditRegionAsync(Region existing)
    {
        var parameters = new DialogParameters<RegionDialog> { { d => d.Region, existing }, { d => d.SubmitLabel, "Save" } };
        var dialogRef = await DialogService.ShowAsync<RegionDialog>("Edit region", parameters);
        var dialogResult = await dialogRef.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not Region region) { return; }
        try
        {
            await PartyService.UpdateRegionAsync(existing.Id, region.Code, region.Name);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }

    private async Task DeleteRegionAsync(Region existing)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete region", $"Delete '{existing.Code}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) { return; }
        try
        {
            await PartyService.DeleteRegionAsync(existing.Id);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await ReloadAsync();
    }
}
